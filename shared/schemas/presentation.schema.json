{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aipptstudio.org/schemas/presentation.schema.json",
  "title": "AI PPT Studio Presentation",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "title",
    "slides"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "slides": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/slide"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "slide": {
      "type": "object",
      "required": [
        "id",
        "elements"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "background": {
          "type": "string"
        },
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element"
          }
        }
      },
      "additionalProperties": false
    },
    "element": {
      "type": "object",
      "required": [
        "id",
        "type",
        "x",
        "y",
        "w",
        "h"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "enum": [
            "text",
            "shape",
            "image"
          ]
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "h": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "text": {
          "type": "string"
        },
        "src": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  }
}
